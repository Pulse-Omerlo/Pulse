
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=your_local_password
POSTGRES_DB=pulse_db
# Host port for the db container; change it if another Postgres already uses 5432.
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://pulse_user:your_local_password@localhost:5432/pulse_db

# Frontend origins allowed to call the API, comma-separated. Defaults to the Vite dev server.
# CORS_ORIGINS=http://localhost:5173

# Largest request body the API accepts, in bytes. Bigger requests get a 413. Defaults to 10 MB.
# MAX_REQUEST_BYTES=10485760

# Sign-in sessions. They last 12 hours by default. The session cookie is Secure; set
# SESSION_COOKIE_SECURE=false only if the UI is served over plain HTTP from a host other
# than localhost. Create users with `uv run python -m app.create_user --tenant <slug> --email <email>`.
# SESSION_HOURS=12
# SESSION_COOKIE_SECURE=true

# Integration tests run only when this is set; uncomment it after
# `docker compose --profile test up -d test-db`
# TEST_DATABASE_URL=postgresql+psycopg://pulse_test:pulse_test@localhost:5433/pulse_test

# Backend log level: DEBUG, INFO, WARN or ERROR. Defaults to INFO.
# LOG_LEVEL=INFO

# Omerlo backoffice API (staging). The API key lives only in the team's private repo.
# Leave both commented out to sync the seeded demo tenants against the local mock server.
# OMERLO_BASE_URL=https://staging.omerlo.app/api
# OMERLO_API_KEY=your_api_key

# Synthetic pipeline into the Omerlo test tenant (python -m synthetic.pipeline --sink omerlo).
# It needs only OMERLO_API_KEY above: the host comes from synthetic/targets/omerlo_staging.toml,
# never from OMERLO_BASE_URL. Syncs against the local mock server ignore the key.
# For --writer cli, the command that carries each call (operation name as last argument, JSON on stdin):
# OMERLO_CLI_COMMAND=your-omerlo-cli --profile staging

# Raw payload archive. Defaults to a local folder (raw-archive/, relative to where the
# backend runs). When hosted, use the Tigris bucket on Fly.io (S3 API). Unset S3 values
# fall back to the AWS_* variables that `fly storage create` sets.
# ARCHIVE_BACKEND=local
# ARCHIVE_DIR=raw-archive
# ARCHIVE_BACKEND=s3
# ARCHIVE_BUCKET=pulse-raw-archive
# ARCHIVE_S3_ENDPOINT_URL=https://fly.storage.tigris.dev
# ARCHIVE_S3_REGION=auto
# ARCHIVE_S3_ACCESS_KEY_ID=your_access_key_id
# ARCHIVE_S3_SECRET_ACCESS_KEY=your_secret_access_key
